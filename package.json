{
  "name": "nepal-football-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @nepal-football-sim/desktop dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "headless:sim": "pnpm --filter @nepal-football-sim/simulation headless:sim",
    "nepal:create-save": "pnpm --filter @nepal-football-sim/simulation nepal:create-save",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.4",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
