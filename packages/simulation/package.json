{
  "name": "@nepal-football-sim/simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "nepal-football-headless": "./dist/cli.js",
    "nepal-football-create-save": "./dist/nepal-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "career:simulate": "pnpm build && node dist/career-cli.js",
    "headless:sim": "pnpm build && node dist/cli.js",
    "development:simulate": "pnpm build && node dist/development-cli.js",
    "economy:simulate": "pnpm build && node dist/economy-cli.js",
    "match:simulate": "pnpm build && node dist/match-cli.js",
    "nepal:create-save": "pnpm build && node dist/nepal-cli.js",
    "players:balance": "pnpm build && node dist/player-balance-cli.js",
    "season:simulate": "pnpm build && node dist/season-cli.js --seasons 1",
    "scouting:simulate": "pnpm build && node dist/scouting-cli.js",
    "years:simulate": "pnpm build && node dist/season-cli.js",
    "match:balance": "pnpm build && node dist/balance-cli.js",
    "tactics:balance": "pnpm build && node dist/tactical-balance-cli.js",
    "transfers:simulate": "pnpm build && node dist/transfers-cli.js",
    "youth:simulate": "pnpm build && node dist/youth-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nepal-football-sim/data-import": "workspace:*",
    "@nepal-football-sim/database": "workspace:*",
    "@nepal-football-sim/shared-types": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
